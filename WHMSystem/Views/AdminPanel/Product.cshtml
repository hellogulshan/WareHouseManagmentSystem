@model IEnumerable<WHMSystem.Models.ProductDto>

@{
    ViewData["Title"] = "Product List";
    Layout = "/Views/Shared/Admin_Layout.cshtml";
}

<link href="~/css/admin-layout.css" rel="stylesheet" />

<style>
    /* Styling the Product Table */
    .table {
        border-radius: 10px;
        overflow: hidden;
    }

        .table thead {
            background-color: #343a40;
            color: white;
        }

        .table th, .table td {
            vertical-align: middle;
            text-align: center;
        }

    .badge {
        font-size: 14px;
        padding: 5px 10px;
    }

    .btn-sm {
        font-size: 14px;
        padding: 5px 10px;
    }

    /* Hover Effects */
    .btn-primary:hover {
        background-color: #0056b3;
    }

    .btn-danger:hover {
        background-color: #b30000;
    }

</style>

<div class="container">
    <h3 class="mb-4"><i class="fas fa-box"></i> Product Management</h3>

    <div class="row align-items-center mb-3">
        <div class="col-md-9">
            <input type="text" id="searchInput" class="form-control" placeholder="🔍 Search by Product Name or Code..." onkeyup="filterProducts()">
        </div>
        <div class="col-md-3 text-end">
            <a href="@Url.Action("AddProduct", "AdminPanel")" class="btn btn-danger">
                <i class="fas fa-plus-circle"></i> Add Product
            </a>
            <i class="fas fa-download text-primary fs-4 ms-3" id="download-icon" title="Download PDF" onclick="downloadPDF()"></i>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Product ID</th>
                    <th>Product Code</th>
                    <th>Product Name</th>
                    <th>Warranty Date</th>
                    <th>Product Type</th>
                    <th>Current Quantity</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                @* <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Warranty</th>
                    <th>Type</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr> *@
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.ProductId</td>
                        <td>@product.ProductCode</td>
                        <td>@product.ProductName</td>
                        <td>@product.WarrantyDate?.ToString("yyyy-MM-dd")</td>
                        <td>@product.ProductTypeName</td>
                        <td>@product.CurrentQuantity</td>
                        <td>
                            @if (product.CurrentQuantity > 0)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> In Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Out of Stock</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("UpdateProduct", "AdminPanel", new { id = product.ProductId })" class="btn btn-sm btn-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>

                            <a href="@Url.Action("DeleteProduct", "AdminPanel", new { id = product.ProductId })" class="btn btn-sm btn-danger ms-2" title="Delete"
                               onclick="confirmDelete(@product.ProductId)"> <i class="fa-solid fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function confirmDelete(productId) {
        if (confirm("Are you sure you want to delete this product?")) {
            window.location.href = '/AdminPanel/DeleteProduct/' + ProductId;
        }
    }
</script>

<script>
    function filterProducts() {
        let input = document.getElementById("searchInput").value.toLowerCase();
        let table = document.querySelector(".table tbody");
        let rows = table.getElementsByTagName("tr");

        for (let i = 0; i < rows.length; i++) {
            let productCode = rows[i].getElementsByTagName("td")[1].innerText.toLowerCase(); // Product Code
            let productName = rows[i].getElementsByTagName("td")[2].innerText.toLowerCase(); // Product Name

            if (productCode.includes(input) || productName.includes(input)) {
                rows[i].style.display = "";
            } else {
                rows[i].style.display = "none";
            }
        }
    }
</script>

<script>
function downloadPDF() {
    // Load jsPDF
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    // Title for the PDF
    doc.text("Product List", 14, 10);

    // Extract Table Data
    const table = document.querySelector("table");
    const rows = [];

    // Extract Headers (Skipping "Status" and "Actions" Columns)
    const headers = [];
    table.querySelectorAll("thead th").forEach((th, index) => {
        if (index !== 6 && index !== 7) { // Skipping "Status" (6th) and "Actions" (7th) columns
            headers.push(th.innerText);
        }
    });

    // Extract Row Data (Skipping "Status" and "Actions" Columns)
    table.querySelectorAll("tbody tr").forEach(tr => {
        const rowData = [];
        tr.querySelectorAll("td").forEach((td, index) => {
            if (index !== 6 && index !== 7) { // Skipping "Status" and "Actions" columns
                rowData.push(td.innerText);
            }
        });
        rows.push(rowData);
    });

    // Add Table to PDF
    doc.autoTable({
        head: [headers],
        body: rows,
        startY: 20,
        styles: { fontSize: 10, cellPadding: 3 },
        headStyles: { fillColor: [0, 123, 255] } // Blue header
    });

    // Save PDF
    doc.save("Product_List.pdf");
}
</script>