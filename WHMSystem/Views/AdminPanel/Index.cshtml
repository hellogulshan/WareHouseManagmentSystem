@model WHMSystem.Models.DashboardDto

@{
    ViewData["Title"] = "Admin Panel";
    Layout = "/Views/Shared/Admin_Layout.cshtml";
}

<link href="~/css/admin-layout.css" rel="stylesheet" />

<div class="container">
    <h3 class="mb-4"><i class="fas fa-tachometer-alt"></i> Dashboard</h3>

    <div class="dashboard-cards">
        <div class="card">
            <i class="fas fa-box"></i>
            <h4>Total Products</h4>
            <p>@Model.TotalProducts</p>
        </div>

        <div class="card">
            <i class="fas fa-shopping-cart"></i>
            <h4>Today New Orders</h4>
            <p>@Model.TodayTotalOrders</p>
        </div>

        <div class="card">
            <i class="fas fa-users"></i>
            <h4>Total Unique Customers</h4>
            <p>@Model.TotalUniqueCustomers</p>
        </div>
    </div>
</div>
