@model List<WHMSystem.Models.GetAllOrdersRequestDto>

@{
    ViewData["Title"] = "Orders Request";
    Layout = "/Views/Shared/Admin_Layout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
<link href="~/css/admin-layout.css" rel="stylesheet" />
<style>
    .orders-container {
        background: #ffffff;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.1);
    }

    .table {
        border-radius: 10px;
        overflow: hidden;
        margin-top: 10px;
    }

        .table thead {
            background: #007bff;
            color: #fff !important;
        }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
            padding: 12px;
        }

        .table tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

    .badge-pending {
        background: #ffc107;
        color: #212529;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
    }

    .badge-completed {
        background: #28a745;
        color: #fff;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
    }

    .action-btn {
        border: none;
        background: none;
        cursor: pointer;
        font-size: 1.1rem;
    }

        .action-btn:hover {
            color: #007bff;
        }
</style>

<div class="container-fluid">
    <div class="orders-container">
        <h4 class="text-primary"><i class="fa-solid fa-boxes"></i> Orders List</h4>

        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Order Date</th>
                            <th>Product Name</th>
                            <th>Warranty Date</th>
                            <th>Quantity</th>
                            <th>Customer Name</th>
                            <th>Customer Address</th>
                            <th>Delivery Option</th>
                            <th>Fulfillment Date</th>
                        </tr>
                        @* <tr>
                            <th>Order ID</th>
                            <th>Order Date</th>
                            <th>Product Name</th>
                            <th>Warranty Date</th>
                            <th>Quantity</th>
                            <th>Customer</th>
                            <th>Address</th>
                            <th>Delivery</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr> *@
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.OrderId</td>
                                <td>@(order.OrderDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                <td>@order.ProductName</td>
                                <td>@(order.WarrantyDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                <td>@order.Quantity</td>
                                <td>@order.CustomerName</td>
                                <td>@order.CustomerAddress</td>
                                <td>@order.DeliveryOptionName</td>
                                @* <td>
                                    @if (order.FulfillmentDate != null)
                                    {
                                        <span class="badge badge-completed">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">Pending</span>
                                    }
                                </td> *@
                                <td>@(order.FulfillmentDate?.ToString("yyyy-MM-dd") ?? "Pending")</td>
                                @* <td>
                                    <button class="action-btn" title="View Order">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="action-btn" title="Edit Order">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="action-btn" title="Process Order">
                                        <i class="fa-solid fa-truck"></i>
                                    </button>
                                </td> *@
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fa-solid fa-info-circle"></i> No orders found.
            </div>
        }
    </div>
</div>
