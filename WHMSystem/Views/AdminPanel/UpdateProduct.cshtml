@model WHMSystem.Models.ProductDto

@{
    ViewData["Title"] = "Update Product";
    Layout = "/Views/Shared/Admin_Layout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    .card {
        border-radius: 10px;
        border: none;
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.1);
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #ced4da;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.25);
        }

    .btn {
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }
</style>

<div class="container mt-4">
    <div class="card p-4">
        <h3 class="text-center text-primary mb-4"><i class="fa-solid fa-pen-to-square"></i> Update Product</h3>

        <form asp-action="UpdateProduct" asp-controller="AdminPanel" method="post">
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="ProductTypeID" />

            <div class="row">
                <!-- Product Code -->
                <div class="col-md-6 mb-3">
                    <label class="form-label"><i class="fa-solid fa-barcode"></i> Product Code</label>
                    <input type="text" asp-for="ProductCode" class="form-control" required />
                </div>

                <!-- Product Name -->
                <div class="col-md-6 mb-3">
                    <label class="form-label"><i class="fa-solid fa-tag"></i> Product Name</label>
                    <input type="text" asp-for="ProductName" class="form-control" required />
                </div>

                <!-- Warranty Date -->
                <div class="col-md-6 mb-3">
                    <label class="form-label"><i class="fa-solid fa-calendar"></i> Warranty Date</label>
                    <input type="date" asp-for="WarrantyDate" class="form-control" />
                </div>

                <!-- Product Type (Readonly) -->
                <div class="col-md-6 mb-3">
                    <label class="form-label"><i class="fa-solid fa-list"></i> Product Type</label>
                    <input type="text" asp-for="ProductTypeName" class="form-control" readonly />
                </div>

                <!-- Current Quantity -->
                <div class="col-md-6 mb-3">
                    <label class="form-label"><i class="fa-solid fa-box"></i> Current Quantity</label>
                    <input type="number" asp-for="CurrentQuantity" class="form-control" required />
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Product", "AdminPanel")" class="btn btn-secondary px-4">
                    <i class="fa-solid fa-arrow-left"></i> Cancel
                </a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="fa-solid fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
